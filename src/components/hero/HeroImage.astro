---
import { Picture } from "astro-imagetools/components";
import Button from "@components/navigation/Button.astro";
import ItemFilter from "@components/navigation/ItemFilter.astro";
import FormattedDate from "@components/FormattedDate.astro";

const {
  title,
  thumbnail,
  hero_buttons,
  hero_logo,
  hero_image_position,
  intro,
  tag,
  filter,
  filters,
  filter_type,
  style,
  pubDate,
  base_url,
  tag_links = true,
} = Astro.props;

const { slug } = Astro.params;
---

<div
  class={`hero relative overflow-hidden nebulix-parallax ${
    style.hero_surface || "surface-dark"
  } ${style.hero_class || ""}`}
  transition:name={`hero_${slug || Math.random()}`}
  id="header"
>
  {
    thumbnail && (
      <div class="media parallax h-full w-full">
        <Picture
          attributes={{
            picture: {
              class: "sm:h-screen",
              style: `opacity: ${style.hero_image_opacity || 0.7}`,
            },
          }}
          src={thumbnail}
          width={1920}
          height={1080}
          ar={16 / 10}
          alt={title}
          breakpoints={[1000, 1280, 1440, 1536, 1920]}
          sizes="100vw"
          loading="eager"
          layout="fill"
          position="entropy"
          objectPosition={hero_image_position}
          artDirectives={[
            {
              media: "(max-width: 500px)",
              ar: 0.6,
              src: thumbnail,
              breakpoints: [320, 360, 390, 412, 500, 601, 768, 1024, 1200],
            },
            {
              media: "(max-width: 1000px)",
              ar: 1,
              src: thumbnail,
              breakpoints: [500, 601, 768, 820, 962, 1280, 1440, 1536, 1920],
            },
          ]}
        />
      </div>
    )
  }

  <div
    class="hero__overlay absolute inset-0 z-10 grid place-items-center bg-dark bg-opacity-20"
  >
    <div class="container-xl py-8">
      <div class="max-w-3xl">
        {
          pubDate && (
            <span class="text-overline">
              <FormattedDate date={pubDate} />
            </span>
          )
        }
        {
          hero_logo && hero_logo.length > 0 ? (
            <div class="my-8 text-left">
              <img src={hero_logo} alt={title} class="hero__logo w-full max-w-md h-auto" style="filter: brightness(0) invert(1) drop-shadow(0 8px 24px rgba(0,0,0,0.45));" loading="eager" />
            </div>
          ) : (
            <h1 class="title">
              {title}
            </h1>
          )
        }
        {intro && <div class="hero__intro subtitle balance py-2">{intro}</div>}

        {
          tag && (
            <ItemFilter
              filters={tag}
              className="mt-4 justify-start"
              links={tag_links}
              {base_url}
            />
          )
        }

        {
          filters && (
            <ItemFilter
              filters={filters}
              className="mt-4"
              links={tag_links}
              active={filter}
              type={filter_type}
              {base_url}
            />
          )
        }
        {
          hero_buttons && hero_buttons.length > 0 && (
            <div class="hero__actions flex flex-wrap gap-4 py-8">
              {hero_buttons.map((btn) => (
                <Button {...btn} />
              ))}
            </div>
          )
        }
        <slot />
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    @screen sm {
      min-height: calc(100svh - 4rem);
    }
  }
  .media {
    @screen sm {
      max-height: calc(100svh - 4rem);
    }
  }

  .hero--cinematic .media {
    @screen sm {
      height: calc(100svh - 4rem);
    }
  }

  .hero--cinematic .hero__overlay {
    background: linear-gradient(
      90deg,
      rgb(var(--color-dark) / 0.75) 0%,
      rgb(var(--color-dark) / 0.35) 55%,
      rgb(var(--color-dark) / 0.1) 100%
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero--cinematic .media :global(img) {
      animation: hero-kenburns 30s ease-in-out infinite alternate;
      transform-origin: 50% 60%;
      will-change: transform;
    }
    .hero--cinematic .hero__logo,
    .hero--cinematic .hero__intro,
    .hero--cinematic .hero__actions {
      animation: hero-reveal 0.8s ease-out both;
    }
    .hero--cinematic .hero__intro {
      animation-delay: 0.2s;
    }
    .hero--cinematic .hero__actions {
      animation-delay: 0.4s;
    }
  }

  @keyframes hero-kenburns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.15);
    }
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
</style>
