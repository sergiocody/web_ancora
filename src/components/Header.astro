---
import NavMobile from "@components/navigation/NavMobile.vue";
import { Icon } from "astro-icon/components";
import logo from "@icons/logoancora.png";

import PageFind from "@components/common/PageFind.astro";
import CartButton from "@components/shop/CartButton.vue";
import ColorSwitch from "@components/common/ColorSwitch.vue";
import { t } from "@util/translate";

const { menu, title, social } = Astro.props;
const currentPath = Astro.url.pathname.split("/")[1];

const isActive = (href) => {
  if (currentPath === "" && href == "/") return true;
  if (currentPath !== "" && href.startsWith(`/${currentPath}`)) return true;
};
const isHome = currentPath === "";
---

<header
  class={`surface-menu nav top-0 z-50 ${isHome ? "nav--overlay fixed inset-x-0" : "sticky"}`}
>
  <nav class="container-xl flex flex-nowrap items-stretch gap-6">
    <a
      href="/"
      class="grid place-items-center py-3 font-heading text-sm uppercase tracking-[0.14em]"
      >Inicio</a
    >
    {
      menu && (
        <ul class="nav-underline nav-links relative hidden flex-nowrap items-center whitespace-nowrap pl-4 font-heading text-sm uppercase tracking-[0.14em] before:absolute before:inset-y-4 before:left-0 before:border-l before:border-current before:opacity-30 xl:flex">
          {menu.map((link) => (
            <li class={`${
              link.special 
                ? 'special-menu-item' 
                : ''
            } ${isActive(link.href) ? "active" : ""}`}>
              <a href={link.href} class={`block py-3 ${
                link.special 
                  ? 'font-bold relative' 
                  : ''
              }`}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      (
        <ul class="nav-underline relative -mr-4  ml-auto flex flex-nowrap justify-end pl-4 uppercase xl:mr-0">
          <li>
            <CartButton
              label={t("cart")}
              client:idle
              transition:persist
              transition:name="cart"
            >
              <Icon name="shopping-cart" class="h-6 w-6" />
            </CartButton>
          </li>
          <li>
            <PageFind />
          </li>

          {social &&
            social.slice(0, 3).map((link) => (
              <li class="hidden 2xl:block">
                <a
                  href={link.href}
                  class="grid h-full place-items-center"
                  target="_blank"
                  aria-label={link.label}
                >
                  <Icon name={link.icon} class="w-6 h-6" />
                </a>
              </li>
            ))}

          <li>
            <ColorSwitch client:idle />
          </li>

          <li class="xl:hidden">
            <NavMobile
              client:idle
              translations={{ menu: t("menu"), close: t("close") }}
            >
              <Icon name="menu-solid" class="h-10 w-10" slot="menu" />

              <Icon name="close" class="h-10 w-10" slot="close" />
              <img src={logo.src} alt={title} class="w-full max-h-20 object-contain" slot="logo" />
              <ul
                class="mobile-links nav-links mt-3 w-full text-center"
                slot="links"
              >
                {menu.map((link, index) => (
                  <li
                    style={`--animation-delay: ${(index + 1) * 100}ms`}
                    class={`title-md inner w-full border-2 border-transparent transition-all duration-1000 hover:border-current  ${
                      isActive(link.href)
                        ? "active font-semibold text-primary"
                        : ""
                    } ${
                      link.special
                        ? "bg-primary bg-opacity-20 border-primary border-2 shadow-lg"
                        : ""
                    }`}
                  >
                    <a href={link.href} class={`block py-3 ${
                      link.special
                        ? "text-primary font-bold"
                        : ""
                    }`}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>

              <ul
                class="relatives flex w-full flex-wrap justify-center gap-2 py-4"
                slot="social"
              >
                {social.map((link, index) => (
                  <li
                    class="inner"
                    style={`--animation-delay: ${(index + 1) * 100}ms`}
                  >
                    <a
                      href={link.href}
                      class="grid h-full place-items-center "
                      target="_blank"
                      aria-label={link.label}
                    >
                      <Icon name={link.icon} class="h-8 w-8" />
                    </a>
                  </li>
                ))}
              </ul>
            </NavMobile>
          </li>
        </ul>
      )
    }
  </nav>
</header>
<style>
  .nav {
    --nav-accent: var(--color-primary);
    transition:
      transform 0.5s ease-in-out,
      color 0.2s ease-in-out;

    /* Glass on a pseudo-element: a filter on the header would trap the fixed mobile menu; view-transition-name would kill the blur */
    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: rgb(var(--color-light) / 0.75);
      backdrop-filter: blur(16px) saturate(140%);
      -webkit-backdrop-filter: blur(16px) saturate(140%);
      border-bottom: 1px solid rgb(0 0 0 / 0.06);
      box-shadow: 0 8px 32px rgb(0 0 0 / 0.08);
      transition: opacity 0.3s ease-in-out;
    }

    ul {
      --_gap: 1rem;
    }
    .nav-underline li:not(ul li ul li) {
      @apply relative overflow-hidden;
      isolation: isolate;
      padding: calc(var(--_gap) / 2);
      min-inline-size: 1.3rem;

      &::after {
        @apply absolute rounded-full;
        content: "";
        inset-inline: 0.5rem;
        inset-block-end: 0.375rem;
        block-size: 3px;
        background: linear-gradient(
          90deg,
          rgb(var(--nav-accent) / 0.4),
          rgb(var(--nav-accent)),
          rgb(var(--nav-accent) / 0.4)
        );
        box-shadow: 0 0 12px rgb(var(--nav-accent) / 0.7);

        translate: var(--_translate, 0);
        scale: var(--_scale, 0) 1;
        transition:
          scale 150ms var(--_scale-delay, 0ms),
          translate 200ms ease-in-out;
      }
      &:hover ~ li {
        --_translate: -100%;
        --_scale-delay: 200ms;
      }
    }

    .nav-links li:not(.special-menu-item) {
      &::before {
        content: "";
        position: absolute;
        inset: 0.375rem 0;
        z-index: -1;
        border-radius: 0.5rem;
        background: rgb(var(--nav-accent) / 0.1);
        opacity: 0;
        scale: 0.85;
        transition:
          opacity 0.2s ease-in-out,
          scale 0.2s ease-in-out;
      }
      a {
        transition:
          translate 0.2s ease-in-out,
          text-shadow 0.2s ease-in-out;
      }
      &:hover {
        &::before {
          opacity: 1;
          scale: 1;
        }
        a {
          translate: 0 -1px;
          text-shadow: 0 0 16px rgb(var(--nav-accent) / 0.5);
        }
      }
    }

    .nav-links li.active {
      --_scale: 1;
      font-weight: 600;
    }

    /* Estilo especial para Ancora Solidario */
    .special-menu-item {
      @apply relative;

      a {
        @apply rounded-lg border-2 border-primary bg-primary bg-opacity-20 px-4 py-2 font-bold;
        color: rgb(var(--color-primary));
        box-shadow: 0 0 15px theme("colors.primary / 0.3");
        transition: all 0.2s ease-in-out;
      }

      &:hover a {
        @apply bg-opacity-30 border-opacity-100;
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 5px 20px theme("colors.primary / 0.5");
      }

      &::after {
        display: none !important;
      }
    }

    &:hover li {
      --_translate: 100%;
      --_scale-delay: 200ms;
    }

    li:hover {
      --_scale: 1;
      --_translate: 0;
      --_scale-delay: 0ms;
      color: rgb(var(--nav-accent));
    }
  }

  header.nav {
    background-color: transparent;
  }

  :global([data-theme="dark"]) .nav::before {
    background: rgb(var(--color-dark) / 0.75);
    border-bottom-color: rgb(255 255 255 / 0.08);
  }

  .nav--overlay {
    --nav-accent: 255 255 255;
    color: white;

    > nav {
      padding-block: 0.75rem;
      transition: padding-block 0.3s ease-in-out;
    }

    .nav-links:not(.mobile-links),
    :global(.nav-mobile-btn:not(.bg-transparent)) {
      color: white;
    }

    &::before {
      background: rgb(var(--color-dark) / 0.8);
      border-bottom-color: rgb(255 255 255 / 0.08);
      box-shadow: 0 8px 32px rgb(0 0 0 / 0.25);
      opacity: 0;
    }

    &::after {
      content: "";
      position: absolute;
      inset: 0 0 -2rem 0;
      z-index: -2;
      pointer-events: none;
      background: linear-gradient(
        to bottom,
        rgb(var(--color-dark) / 0.6),
        transparent
      );
      transition: opacity 0.3s ease-in-out;
    }

    .special-menu-item a {
      color: white;
      background-color: rgb(var(--color-primary) / 0.6);
      border-color: rgb(255 255 255 / 0.35);
    }
  }

  :global(html[data-is-top="false"]) .nav--overlay {
    > nav {
      padding-block: 0;
    }
    &::before {
      opacity: 1;
    }
    &::after {
      opacity: 0;
    }
  }
</style>
